<mvc:View controllerName="testapp.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <content>
            <Table id="_IDGenTable1" items="{dummy>/employees}">
                <columns>
                    <Column id="_IDGenColumn">
                        <Text id="_IDGenText" text="ID" />
                    </Column>
                    <Column id="_IDGenColumn1">
                        <Text id="_IDGenText1" text="Name" />
                    </Column>
                    <Column id="_IDGenColumn2">
                        <Text id="_IDGenText2" text="Department" />
                    </Column>
                    <Column id="_IDGenColumn3">
                        <Text id="_IDGenText2" text="Manager" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem">
                        <cells>
                            <Text id="_IDGenText3" text="{dummy>id}" />
                            <Text id="_IDGenText4" text="{dummy>name}" />
                            <Text id="_IDGenText5" text="{dummy>department}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>